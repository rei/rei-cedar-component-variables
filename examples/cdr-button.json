{
  "name": "cdr-button",
  "notes": [
    "Use the base mixin plus a color variant. Icon-only buttons add icon-only after the color variant; a circular background adds with-background last.",
    "Load @rei/cdr-tokens/css at runtime (15.0.0-alpha.4). No Vue runtime is needed.",
    "Use an accessible name for icon-only buttons. Native disabled attributes activate the disabled styles.",
    "Size and full-width mixins accept an optional breakpoint: xs, sm, md, or lg. Public color overrides use --cdr-color-button-*."
  ],
  "docs": "https://cedar.rei.com/components/buttons/",
  "examples": [
    {
      "name": "primary",
      "html": "<button class=\"cdr-button-primary\">primary</button>",
      "scss": [
        "@include cdr-button-base-mixin;",
        "@include cdr-button-primary-mixin;"
      ]
    },

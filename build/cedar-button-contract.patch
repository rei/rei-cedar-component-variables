new file mode 100644
index 000000000..133fc7e0a
--- /dev/null
+++ b/src/components/button/styles/vars/CdrButton.recipe.scss
@@ -0,0 +1,459 @@
+@use '@rei/cdr-tokens/scss' as tokens;
+@use 'sass:map';
+@use './CdrButton.maps' as maps;
+
+// ============================================================================
+// BASE
+// ============================================================================
+
+@mixin cdr-button-base-mixin() {
+  border: none;
+  cursor: pointer;
+  display: inline-flex;
+  outline: none;
+  overflow: visible;
+  margin: 0;
+  text-align: left;
+  text-decoration: none;
+  text-transform: none;
+  vertical-align: middle;
+
+  // Every base variable comes from the generated contract map.
+  @each $key, $value in maps.$button-defaults {
+    --cdr-button-#{$key}: #{$value};
+  }
+
+  // Approved alpha.2 gap and brand data fixes, shared with non-Vue consumers.
+  --cdr-border-neutral-trace: #ffffff;
+  --cdr-action-surface-brand: #143528;
+  --cdr-action-text-brand: #143528;
+  --cdr-action-border-brand: #143528;
+
+  border-radius: var(--cdr-button-radius);
+  font-family: var(--cdr-button-font-family);
+  font-style: var(--cdr-button-font-style);
+  font-weight: var(--cdr-button-font-weight);
+  letter-spacing: var(--cdr-button-letter-spacing);
+  font-size: var(--cdr-button-font-size);
+  line-height: var(--cdr-button-line-height);
+  padding: var(--cdr-button-padding);
+  transition:
+    box-shadow var(--cdr-button-transition-duration) var(--cdr-button-transition-timing),
+    background-color var(--cdr-button-transition-duration) var(--cdr-button-transition-timing),
+    color var(--cdr-button-transition-duration) var(--cdr-button-transition-timing),
+    fill var(--cdr-button-transition-duration) var(--cdr-button-transition-timing);
+
+  &:hover,
+  &:active,
+  &:focus {
+    outline: none;
+    outline-offset: 0;
+    text-decoration: none;
+  }
+
+  &[disabled] {
+    cursor: not-allowed;
+  }
+
+  svg {
+    @include cdr-button-base-icon-mixin;
+
+    width: var(--cdr-button-icon-size);
+    height: var(--cdr-button-icon-size);
+  }
+
+  &.cdr-button--has-icon-left {
+    padding-left: calc(var(--cdr-button-icon-padding) - var(--cdr-button-icon-gap));
+
+    svg {
+      margin-right: var(--cdr-button-icon-gap);
+    }
+  }
+
+  &.cdr-button--has-icon-right {
+    padding-right: calc(var(--cdr-button-icon-padding) - var(--cdr-button-icon-gap));
+
+    svg {
+      margin-left: var(--cdr-button-icon-gap);
+    }
+  }
+}
+
+@mixin cdr-button-base-icon-mixin() {
+  align-self: center;
+  fill: inherit;
+}
+
+@mixin cdr-button-base-text($size) {
+  @each $property in (font-family, font-style, font-weight, letter-spacing) {
+    #{$property}: map.get(maps.$button-defaults, $property);
+  }
+
+  @each $property in (font-size, line-height) {
+    #{$property}: map.get(maps.$button-sizes, $size, $property);
+  }
+}
+
+@mixin cdr-button-icon-size($size) {
+  --cdr-button-icon-size: #{map.get(maps.$button-sizes, $size, icon-size)};
+
+  width: var(--cdr-button-icon-size);
+  height: var(--cdr-button-icon-size);
+}
+
+@mixin cdr-button-icon-padding($size, $side) {
+  $padding: map.get(maps.$button-sizes, $size, icon-padding);
+  $gap: map.get(maps.$button-defaults, icon-gap);
+
+  --cdr-button-icon-padding: #{$padding};
+
+  padding-#{$side}: calc(#{$padding} - #{$gap});
+}
+
+// ============================================================================
+// COLOR SCOPES
+// Driven by the generated maps. Every entry already carries its public
+// override hook plus the semantic token, for example
+// var(--cdr-color-button-surface, var(--cdr-action-surface-brand)),
+// so the loops below compile to exactly two var() levels per declaration.
+// ============================================================================
+
+// Emit the surface/text/icon declarations for one generated state suffix.
+@mixin _state-colors($colors, $suffix) {
+  @each $key, $value in $colors {
+    @if $key == 'background#{$suffix}' {
+      background-color: $value;
+    } @else if $key == 'text#{$suffix}' {
+      color: $value;
+    } @else if $key == 'fill#{$suffix}' {
+      fill: $value;
+    }
+  }
+}
+
+// Emit the border box-shadow for one state. Active scopes add the inset ring.
+@mixin _border-shadow($colors, $state) {
+  @if $state == rest {
+    @if map.has-key($colors, border) {
+      box-shadow:
+        inset 0 0 0 1px map.get($colors, border),
+        var(--cdr-button-elevation);
+    }
+  } @else if $state == hover {
+    @if map.has-key($colors, border-hover) {
+      box-shadow:
+        inset 0 0 0 3px map.get($colors, border-hover),
+        var(--cdr-button-elevation-hover);
+    }
+  } @else if $state == focus-visible {
+    @if map.has-key($colors, border-focus-visible) {
+      box-shadow:
+        inset 0 0 0 3px map.get($colors, border-focus-visible),
+        var(--cdr-button-elevation-focus-visible);
+    }
+  } @else if $state == active {
+    @if map.has-key($colors, border-active) {
+      @if map.has-key($colors, active-inset) {
+        box-shadow:
+          inset 0 0 0 3px map.get($colors, border-active),
+          inset 0 0 0 5px map.get($colors, active-inset),
+          var(--cdr-button-elevation-active);
+      } @else {
+        box-shadow:
+          inset 0 0 0 3px map.get($colors, border-active),
+          inset 0 0 0 5px var(--cdr-border-neutral-trace),
+          var(--cdr-button-elevation-active);
+      }
+    }
+  } @else if $state == disabled {
+    @if map.has-key($colors, border-disabled) {
+      box-shadow: inset 0 0 0 1px map.get($colors, border-disabled);
+    }
+  }
+}
+
+// Emit a full role × state scope (primary/secondary/dark/sale).
+@mixin cdr-button-variant-colors($colors) {
+  @include _state-colors($colors, '');
+  @include _border-shadow($colors, rest);
+
+  &:hover {
+    @include _state-colors($colors, '-hover');
+    @include _border-shadow($colors, hover);
+  }
+
+  &:focus-visible {
+    @include _state-colors($colors, '-focus-visible');
+    @include _border-shadow($colors, focus-visible);
+  }
+
+  &:active {
+    @include _state-colors($colors, '-active');
+    @include _border-shadow($colors, active);
+  }
+
+  &[disabled] {
+    @include _state-colors($colors, '-disabled');
+    @include _border-shadow($colors, disabled);
+  }
+}
+
+// ============================================================================
+// SPECIAL CASE MIXINS
+// Structural variants that override the standard action-family pattern.
+// Used by the module file and component-variables consumers. Values come from
+// the same generated maps, so their hooks stay overridable.
+// ============================================================================
+
+// ── Link — no background/border, underline instead ──────────────────────────
+
+@mixin _link() {
+  $colors: map.get(maps.$button-colors, link);
+
+  background-color: map.get($colors, surface);
+  color: map.get($colors, text);
+  fill: map.get($colors, fill);
+  text-decoration: underline;
+
+  &:hover {
+    color: map.get($colors, text-hover);
+    text-decoration: none;
+  }
+
+  &:focus-visible {
+    color: map.get($colors, text-focus-visible);
+  }
+
+  &:active {
+    color: map.get($colors, text-active);
+  }
+
+  &[disabled] {
+    color: map.get($colors, text-disabled);
+    fill: map.get($colors, fill-disabled);
+    text-decoration: none;
+  }
+
+  // ITEM_DOC: Link button's focus outline. Override with --cdr-button-link-outline.
+  &:focus {
+    outline: var(--cdr-button-link-outline, var(--default-outline, 0.2rem solid Highlight));
+    outline-color: -webkit-focus-ring-color;
+    outline-offset: 0;
+  }
+}
+
+// ── Icon-only — completely different layout ─────────────────────────────────
+
+@mixin _icon-only() {
+  $colors: map.get(maps.$button-colors, icon-only);
+
+  background: none;
+  border: none;
+  border-radius: var(--cdr-button-icon-only-radius);
+  box-shadow: none;
+  display: inline-block;
+  line-height: normal;
+  padding: var(--cdr-button-icon-only-padding);
+  fill: map.get($colors, fill);
+
+  &:hover {
+    background: none;
+    border: none;
+    box-shadow: none;
+    fill: map.get($colors, fill-hover);
+  }
+
+  &:focus-visible {
+    background: none;
+    outline: none;
+    border: none;
+    box-shadow: none;
+    fill: map.get($colors, fill-focus-visible);
+
+    svg {
+      box-shadow: inset 0 0 0 1px map.get($colors, border-focus-visible);
+    }
+  }
+
+  &:active {
+    background: none;
+    outline: none;
+    border: none;
+    box-shadow: none;
+    fill: map.get($colors, fill-active);
+
+    svg {
+      box-shadow: inset 0 0 0 1px map.get($colors, border-active);
+    }
+  }
+
+  &[disabled] {
+    background: transparent;
+    border: none;
+    box-shadow: none;
+    fill: map.get($colors, fill-disabled);
+  }
+
+  > svg {
+    margin: 0;
+  }
+}
+
+// ── With-background — secondary colors + circular shape ─────────────────────
+
+@mixin _with-background() {
+  $colors: map.get(maps.$button-colors, with-background);
+
+  border-radius: 50%;
+  background-color: map.get($colors, background);
+  fill: map.get($colors, fill);
+  box-shadow: inset 0 0 0 1px map.get($colors, border);
+
+  &:hover {
+    background-color: map.get($colors, background-hover);
+    fill: map.get($colors, fill-hover);
+    box-shadow:
+      inset 0 0 0 3px map.get($colors, border-hover),
+      var(--cdr-button-elevation-hover);
+
+    svg {
+      box-shadow: none;
+    }
+  }
+
+  &:focus-visible {
+    background-color: map.get($colors, background-focus-visible);
+    fill: map.get($colors, fill-focus-visible);
+    box-shadow:
+      inset 0 0 0 3px map.get($colors, border-focus-visible),
+      var(--cdr-button-elevation-focus-visible);
+
+    svg {
+      box-shadow: none;
+    }
+  }
+
+  &:active {
+    background-color: map.get($colors, background-active);
+    color: map.get($colors, text-active);
+    fill: map.get($colors, fill-active);
+    box-shadow:
+      inset 0 0 0 3px map.get($colors, border-active),
+      inset 0 0 0 5px map.get($colors, active-inset),
+      var(--cdr-button-elevation-active);
+
+    svg {
+      box-shadow: none;
+    }
+  }
+
+  &[disabled] {
+    background-color: map.get($colors, background-disabled);
+    fill: map.get($colors, fill-disabled);
+    box-shadow: inset 0 0 0 1px map.get($colors, border-disabled);
+  }
+}
+
+// ── Elevated — swaps the elevation layer ────────────────────────────────────
+
+@mixin cdr-button-elevated-mixin() {
+  --cdr-button-elevation: #{tokens.$cdr-prominence-elevated};
+  --cdr-button-elevation-hover: #{tokens.$cdr-prominence-floating};
+  --cdr-button-elevation-focus-visible: #{tokens.$cdr-prominence-floating};
+  --cdr-button-elevation-active: #{tokens.$cdr-prominence-raised};
+}
+
+@mixin cdr-button-elevated-variant($variant) {
+  @include cdr-button-elevated-mixin;
+
+  $colors: map.get(maps.$button-elevated-colors, $variant);
+
+  @include _border-shadow($colors, rest);
+
+  &:hover {
+    @include _border-shadow($colors, hover);
+  }
+
+  &:focus-visible {
+    @include _border-shadow($colors, focus-visible);
+  }
+
+  &:active {
+    @include _border-shadow($colors, active);
+  }
+
+  &[disabled] {
+    @include _border-shadow(map.get(maps.$button-colors, $variant), disabled);
+  }
+}
+
+// ============================================================================
+// PUBLIC RECIPE OPERATIONS — named variant and size wrappers are generated.
+// ============================================================================
+
+@mixin cdr-button-apply-variant($variant) {
+  @if $variant == link {
+    @include _link;
+  } @else if $variant == icon-only {
+    @include _icon-only;
+  } @else if $variant == with-background {
+    @include _with-background;
+  } @else {
+    $colors: map.get(maps.$button-colors, $variant);
+
+    @if $colors {
+      @include cdr-button-variant-colors($colors);
+    } @else {
+      @error "Unknown CdrButton variant: #{$variant}";
+    }
+  }
+}
+
+@mixin cdr-button-apply-size($size) {
+  $s: map.get(maps.$button-sizes, $size);
+
+  @if not $s {
+    @error "Unknown CdrButton size: #{$size}";
+  }
+
+  @each $key, $value in $s {
+    --cdr-button-#{$key}: #{$value};
+  }
+
+  width: auto;
+}
+
+@mixin cdr-button-at-breakpoint($breakpoint: null) {
+  @if not $breakpoint {
+    @content;
+  } @else if $breakpoint == xs {
+    @include tokens.cdr-xs-mq-only {
+      @content;
+    }
+  } @else if $breakpoint == sm {
+    @include tokens.cdr-sm-mq-only {
+      @content;
+    }
+  } @else if $breakpoint == md {
+    @include tokens.cdr-md-mq-only {
+      @content;
+    }
+  } @else if $breakpoint == lg {
+    @include tokens.cdr-lg-mq-only {
+      @content;
+    }
+  } @else {
+    @error "Unknown CdrButton breakpoint: #{$breakpoint}";
+  }
+}
+
+@mixin cdr-button-full-width-mixin($breakpoint: null) {
+  @include cdr-button-at-breakpoint($breakpoint) {
+    width: 100% !important;
+    justify-content: center;
+  }
+}
+
+@mixin cdr-button-icon-only-large-mixin() {
+  padding: var(--cdr-button-icon-only-large-padding);
+}

{
  "name": "@rei/cdr-component-variables",
  "version": "11.0.0",
  "description": "Style variables exported from Cedar components",
  "style": "dist/scss/index.scss",
  "files": [
    "dist"
  ],
  "scripts": {
    "build:docs-data": "node ./build/build-docs-data.js",
    "prepublishOnly": "npm run build:docs-data",
    "prerelease": "npm-publish-prerelease",
    "build:all": "pnpm --dir ../rei-cedar build:variables && pnpm build:docs-data",
    "test:all": "pnpm test:setup && pnpm --dir ../rei-cedar test:variables",
    "setup:cedar": "node build/prepare-cedar.mjs && pnpm --dir ../rei-cedar install --frozen-lockfile",
    "test:setup": "node --test build/prepare-cedar.test.mjs"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rei/rei-cedar-component-variables.git"
  },
  "homepage": "https://rei.github.io/rei-cedar-component-variables/#/",
  "author": "REI Software Engineering",
  "license": "MIT",
  "devDependencies": {
    "@rei/cedar-icons": "^2.5.1",
    "@rei/cdr-tokens": "15.0.0-alpha.2",
    "@rei/cedar": "17.0.0",
    "fs-extra": "^9.1.0",
    "less-plugin-sass2less": "^1.2.0",
    "npm-publish-prerelease": "^1.0.2",
    "postcss": "^8.2.6",
    "postcss-cli": "^8.3.1",
    "postcss-inline-svg": "^5.0.0"
  },
  "peerDependencies": {
    "@rei/cdr-tokens": "15.0.0-alpha.2"
  }
}
